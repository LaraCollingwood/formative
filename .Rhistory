library(this.path)
library(readstata13)
library(ggplot2)
library(dplyr)
library(biostat3)
library(interactions)
library(mfp)
library(rms)
setwd(paste0(this.dir(), "/../"))
CEBU_data <- read.dta13("data/MSHDS_IRM_formative_dataset_CEBU_2025.dta", nonint.factors = TRUE)
head(CEBU_data, 10)
CEBU_data$smk_preg <- as.factor(CEBU_data$smk_preg)
CEBU_data$firstprg <- as.factor(CEBU_data$firstprg)
plot(CEBU_data$gest_wk, CEBU_data$smk_preg)
CEBU_data |>
ggplot(aes(x=gest_wk)) +
geom_bar()
CEBU_data |>
filter(smk_preg==0) |>
ggplot(aes(x=gest_wk)) +
geom_bar() +
ggtitle("non-smokers")
CEBU_data |>
filter(smk_preg==1) |>
ggplot(aes(x=gest_wk)) +
geom_bar() +
ggtitle("smokers")
CEBU_data |>
ggplot(aes(x=as.factor(smk_preg), y=gest_wk)) +
geom_boxplot() +
stat_summary(fun.y=mean, geom="point", shape=20, size=6, color="red", fill="red")
summary(CEBU_data$gest_wk)
summary(CEBU_data$smk_preg)
CEBU_data |>
group_by(gest_wk) |>
summarise(n=n())
model1 <-lm(gest_wk ~ as.factor(smk_preg), data=CEBU_data)
summary(model1)
cbind(coefficients(model1), confint(model1))
model2 <-lm(gest_wk ~ as.factor(smk_preg) * as.factor(firstprg), data=CEBU_data)
summary(model2)
cbind(coefficients(model2), confint(model2))
# swap the reference category for first pregnancy to get new CIs
CEBU_data$firstprg <- relevel(CEBU_data$firstprg, ref = "1. Yes")
model2 <-lm(gest_wk ~ as.factor(smk_preg) * as.factor(firstprg), data=CEBU_data)
cbind(coefficients(model2), confint(model2))
# reset the reference level
CEBU_data$firstprg <- relevel(CEBU_data$firstprg, ref = "0. No")
difference1 <- "as.factor(smk_preg)1"
lincom(model2, difference1)
difference1 <- "as.factor(firstprg)1. Yes"
lincom(model2, difference1)
